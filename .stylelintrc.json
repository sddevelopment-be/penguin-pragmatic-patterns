{
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-standard-scss"
  ],
  "rules": {
    "color-hex-length": "short",
    "selector-class-pattern": "^[a-z0-9\\-]+$",
    "declaration-property-value-no-unknown": [
      true,
      {
        "ignoreProperties": {
          "/.*/": "/\\$/"
        }
      }
    ]
  }
}
