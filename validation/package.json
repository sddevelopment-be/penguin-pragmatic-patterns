{
  "name": "validation",
  "version": "1.0.0",
  "type": "module",
  "description": "Validation tooling for Penguin Pragmatic Patterns",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test": "cypress run",
    "test:headed": "cypress run --headed",
    "test:chrome": "cypress run --browser chrome",
    "test:firefox": "cypress run --browser firefox",
    "lint:css": "stylelint \"../assets/styles/**/*.scss\"",
    "lint:md": "remark --config remark-config.mjs --frail '../content/**/*.md'",
    "lint:spell": "cspell --config cspell.config.yaml '../content/en/**/*.md' '../data/**/*.toml' '../README.md'  --exclude '**/*_nl.toml' ",
    "lint": "npm run lint:css && npm run lint:md && npm run lint:spell",
    "test:hugo": "bash scripts/run-hugo-tests.sh",
    "perf:lighthouse": "bash scripts/run-lighthouse.sh",
    "test:cypress": "cypress run",
    "test:smoke": "bash scripts/run-smoke-tests.sh"
  },
  "keywords": [
    "testing",
    "cypress",
    "e2e",
    "validation"
  ],
  "author": "",
  "license": "ISC",
  "config": {
    "lighthouse_url": "http://localhost:1313/"
  },
  "overrides": {
    "fast-xml-parser": ">=5.7.0",
    "minimatch": ">=10.2.3",
    "picomatch": ">=4.0.4",
    "node-forge": ">=1.4.0",
    "flatted": ">=3.4.2",
    "underscore": ">=1.13.8",
    "immutable": ">=5.1.5",
    "jws": ">=3.2.3",
    "glob": ">=11.1.0",
    "axios": ">=1.15.0",
    "follow-redirects": ">=1.15.12",
    "brace-expansion": ">=5.0.5",
    "ajv": ">=8.18.0",
    "js-yaml": ">=4.1.1",
    "lodash": ">=4.18.0",
    "markdown-it": ">=14.1.1",
    "@eslint/plugin-kit": ">=0.3.4"
  },
  "devDependencies": {
    "cspell": "^9.3.0",
    "cypress": "^15.6.0",
    "eslint": "^9.39.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-cypress": "^5.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-promise": "^7.2.1",
    "lighthouse": "^13.0.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-preset-lint-consistent": "^6.0.1",
    "sitespeed.io": "^39.5.0",
    "stylelint": "^16.25.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard-scss": "^16.0.0",
    "wait-on": "^9.0.3"
  }
}
